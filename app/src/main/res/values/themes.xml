<resources>
    <style name="Theme.OlcrtcClient" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorPrimary">@color/olcrtc_primary</item>
        <item name="colorOnPrimary">@color/olcrtc_on_primary</item>
        <item name="colorPrimaryContainer">@color/olcrtc_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/olcrtc_on_primary_container</item>
        <item name="colorSecondary">@color/olcrtc_secondary</item>
        <item name="colorOnSecondary">@color/olcrtc_on_secondary</item>
        <item name="colorSurface">@color/olcrtc_surface</item>
        <item name="colorSurfaceContainer">@color/olcrtc_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/olcrtc_surface_container_high</item>
        <item name="colorOnSurface">@color/olcrtc_on_surface</item>
        <item name="colorSurfaceVariant">@color/olcrtc_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/olcrtc_on_surface_variant</item>
        <item name="colorOutline">@color/olcrtc_outline</item>
        <item name="colorError">@color/olcrtc_error</item>
        <item name="colorOnError">@color/olcrtc_on_error</item>
        <item name="android:colorBackground">@color/olcrtc_surface</item>
        <item name="android:statusBarColor">@color/olcrtc_surface</item>
        <item name="android:navigationBarColor">@color/olcrtc_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Olcrtc.Headline</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Olcrtc.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Olcrtc.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Olcrtc.TitleSmall</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.OlcrtcClient.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.OlcrtcClient.LargeComponent</item>
    </style>

    <style name="Theme.OlcrtcClient.ProfileChooser" parent="Theme.OlcrtcClient">
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <style name="ShapeAppearance.OlcrtcClient.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="Widget.OlcrtcClient.SettingsRow" parent="">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">76dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="Widget.OlcrtcClient.SettingsDivider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:alpha">0.25</item>
        <item name="android:background">?attr/colorOutline</item>
    </style>

    <style name="Widget.OlcrtcClient.BottomNavigation.Item" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="Widget.OlcrtcClient.BottomNavigation.Indicator" parent="">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:background">@drawable/bg_main_navigation_indicator</item>
        <item name="android:duplicateParentState">true</item>
    </style>

    <style name="Widget.OlcrtcClient.BottomNavigation.Icon" parent="">
        <item name="android:layout_width">@dimen/icon_navigation_size</item>
        <item name="android:layout_height">@dimen/icon_navigation_size</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:tint">@color/main_navigation_item</item>
    </style>

    <style name="Widget.OlcrtcClient.BottomNavigation.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/main_navigation_item</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="ShapeAppearance.OlcrtcClient.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="TextAppearance.Olcrtc.Wordmark" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.04</item>
    </style>

    <style name="TextAppearance.Olcrtc.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Olcrtc.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="TextAppearance.Olcrtc.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Olcrtc.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Olcrtc.Data" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
